{
  "expo": {
    "name": "KeeperGo",
    "slug": "keepergo",
    "scheme": "keepergo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-KeeperGo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keepergo.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.keepergo.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-KeeperGo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1cb9ad91-a41f-487e-9d88-898aa3671571"
      }
    },
    "owner": "lyann-mm"
  }
}
